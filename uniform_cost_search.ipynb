import heapq
# uniform cost function
# returns the minimum cost and the path with minimum cost
def  uniform_cost_search(start, goal, graph, cost):
    #this stores the current cost, current node, and the path taken so far
    queue =  [(0, start, [start])]

    answer = {node: {'cost': float('inf'), 'path': []} for node in goal}

    #this tracks the minimum cost to reach a node
    visited = {}

    while queue:
        #this sorts the queue so that the lowest value is done first
        queue.sort()
        #this pops the node with the lowest cost
        curr_cost, node, path = queue.pop(0)

        #this skips a node if the node has already been visited with a lower or equal cost
        if node in visited and visited[node] <= curr_cost:
            continue
        visited[node] = curr_cost

        #this updates the answer if it's a goal state and found with a lower cost
        if node in goal and curr_cost < answer[node]['cost']:
            answer[node] = {'cost' : curr_cost, 'path' : path}

        #this expands neighbors
        for neighbor in graph[node]:
            edge_cost = cost.get((node, neighbor), float('inf'))
            new_cost = curr_cost + edge_cost
            queue.append((new_cost, neighbor, path + [neighbor])) 

    return answer
 
